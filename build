#!/usr/bin/env sh

set -euf

DOCKER_COMMAND=${DOCKER_COMMAND:-podman}
PLATFORMS=${PLATFORMS:-linux/amd64,linux/arm64}
# CI starts with empty storage, so it uses "missing" to avoid extra registry
# requests counting towards Docker Hub's pull limit
PULL_POLICY=${PULL_POLICY:-always}
REPOSITORY=docker.io/robjdavey/minecraft-server
HUB_TAGS_URL=https://hub.docker.com/v2/namespaces/robjdavey/repositories/minecraft-server/tags
PAPER_API=https://fill.papermc.io/v3/projects/paper
# Paper versions before 1.18 (Java 17) use an older Paperclip format that the
# Dockerfile doesn't support yet
MIN_JAVA_VERSION=17
# The Alpine base images only support arm64 from Java 21
MIN_ALPINE_JAVA_VERSION=21
export BUILDAH_FORMAT=docker

usage() {
    echo "Usage: $0 [full|alpine] [version]"
    echo "       $0 plan"
    exit 4
}

requireCommand() {
    if ! command -v "$1" >/dev/null; then
        echo "$1 not installed"
        exit "$2"
    fi
}

variantSuffix() {
    case "$1" in
        full) echo "" ;;
        alpine) echo "-alpine" ;;
        *) usage ;;
    esac
}

variantSupported() {
    [ "$1" != "alpine" ] || [ "$2" -ge "$MIN_ALPINE_JAVA_VERSION" ]
}

javaVersion() {
    printf '%s' "$versions" | jq -r --arg v "$1" 'first(.versions[] | select(.version.id == $v)) | .version.java.version.minimum'
}

latestStableBuild() {
    curl -fsSL "$PAPER_API/versions/$1/builds" | jq -c 'map(select(.channel == "STABLE")) | first // empty'
}

# Print "version build java" for each version that has a stable build and a
# supported Java version, newest first. With "first", stop after the newest.
buildableVersions() {
    for version_number in $(printf '%s' "$versions" | jq -r '.versions[].version.id'); do
        java_version=$(javaVersion "$version_number")

        if [ "$java_version" -lt "$MIN_JAVA_VERSION" ]; then
            continue
        fi

        build_id=$(latestStableBuild "$version_number" | jq -r '.id // empty')

        if [ -z "$build_id" ]; then
            continue
        fi

        printf '%s %s %s\n' "$version_number" "$build_id" "$java_version"

        if [ "${1:-}" = "first" ]; then
            break
        fi
    done
}

hubTags() {
    url="$HUB_TAGS_URL?page_size=100"

    while [ -n "$url" ] && [ "$url" != "null" ]; do
        page=$(curl -fsSL "$url")
        printf '%s' "$page" | jq -r '.results[].name'
        url=$(printf '%s' "$page" | jq -r '.next')
    done
}

# Print a JSON list of the images that need building. An image needs building
# when its version-build tag (e.g. 1.21.10-130) isn't on Docker Hub yet, or
# always when FORCE is true.
plan() {
    existing_tags=$(hubTags)
    buildable_versions=$(buildableVersions)

    printf '%s\n' "$buildable_versions" | while read -r version_number build_id java_version; do
        for variant in full alpine; do
            if ! variantSupported "$variant" "$java_version"; then
                continue
            fi

            tag="${version_number}-${build_id}$(variantSuffix "$variant")"

            if [ "${FORCE:-false}" = "true" ]; then
                printf 'Rebuilding: %s\n' "$tag" >&2
            elif printf '%s\n' "$existing_tags" | grep -qxF "$tag"; then
                printf 'Already published: %s\n' "$tag" >&2
                continue
            else
                printf 'Needs building: %s\n' "$tag" >&2
            fi

            jq -cn --arg variant "$variant" --arg version "$version_number" '{variant: $variant, version: $version}'
        done
    done | jq -cs .
}

# Check the image for the given platform contains binaries for that CPU, then
# start it with no network, wait for the server to finish starting, and check
# it shuts down cleanly. Emulated platforms start slowly, so allow up to 5
# minutes.
smokeTest() {
    printf 'Smoke testing %s\n' "$2"

    case "$2" in
        linux/amd64) expected_arch=x86_64 ;;
        linux/arm64) expected_arch=aarch64 ;;
        *) expected_arch=unknown ;;
    esac
    actual_arch=$($DOCKER_COMMAND run --rm --pull=never --platform "$2" --network none --entrypoint uname "$1" -m)

    if [ "$actual_arch" != "$expected_arch" ]; then
        echo "Smoke test failed: $2 image contains $actual_arch binaries"
        return 1
    fi

    container=$($DOCKER_COMMAND run -d --pull=never --platform "$2" --network none -e MEMORY=1G "$1")
    started=false

    for _ in $(seq 300); do
        if $DOCKER_COMMAND logs "$container" 2>&1 | grep -q 'Done ('; then
            started=true
            break
        fi
        if [ "$($DOCKER_COMMAND inspect -f '{{.State.Running}}' "$container")" != "true" ]; then
            break
        fi
        sleep 1
    done

    $DOCKER_COMMAND stop -t 60 "$container" >/dev/null
    logs=$($DOCKER_COMMAND logs "$container" 2>&1)
    $DOCKER_COMMAND rm -v "$container" >/dev/null

    if [ "$started" != "true" ]; then
        printf '%s\n' "$logs"
        echo "Smoke test failed: server did not start"
        return 1
    fi

    if ! printf '%s' "$logs" | grep -q 'Saving worlds'; then
        printf '%s\n' "$logs"
        echo "Smoke test failed: server did not shut down cleanly"
        return 1
    fi

    printf 'Smoke test passed on %s\n' "$2"
}

# Build, smoke test and push one version of one variant. The version-build tag
# is pushed last, so a failed run is retried by the next plan.
build() {
    variant=$1
    suffix=$(variantSuffix "$variant")
    latest_version_number=$(buildableVersions first | cut -d ' ' -f 1)
    version_number=${2:-$latest_version_number}
    java_version=$(javaVersion "$version_number")

    if [ -z "$java_version" ] || [ "$java_version" = "null" ]; then
        echo "Unknown Minecraft version: $version_number"
        exit 5
    fi

    if [ "$java_version" -lt "$MIN_JAVA_VERSION" ]; then
        echo "Minecraft $version_number needs Java $java_version, older than the minimum of $MIN_JAVA_VERSION"
        exit 5
    fi

    if ! variantSupported "$variant" "$java_version"; then
        echo "The $variant variant needs Java $MIN_ALPINE_JAVA_VERSION or newer, but Minecraft $version_number uses Java $java_version"
        exit 5
    fi

    latest_stable_build=$(latestStableBuild "$version_number")

    if [ -z "$latest_stable_build" ]; then
        echo "Minecraft $version_number has no stable build"
        exit 5
    fi

    latest_stable_build_id=$(printf '%s' "$latest_stable_build" | jq -r '.id')
    download_url=$(printf '%s' "$latest_stable_build" | jq -r '.downloads."server:default".url')
    download_sha256=$(printf '%s' "$latest_stable_build" | jq -r '.downloads."server:default".checksums.sha256')
    recommended_flags=$(printf '%s' "$versions" | jq -r --arg v "$version_number" 'first(.versions[] | select(.version.id == $v)) | .version.java.flags.recommended | join(" ")')

    printf 'Building Minecraft %s with build %s on Java %s\n' "$version_number" "$latest_stable_build_id" "$java_version"

    image="$REPOSITORY:${version_number}${suffix}"

    # Remove any local image or manifest list with this name, so the build
    # starts a fresh manifest list instead of adding to an old one
    if $DOCKER_COMMAND manifest exists "$image"; then
        $DOCKER_COMMAND manifest rm "$image" >/dev/null
    elif $DOCKER_COMMAND image exists "$image"; then
        $DOCKER_COMMAND rmi "$image" >/dev/null
    fi

    $DOCKER_COMMAND build --pull="$PULL_POLICY" -f ./Dockerfile \
        --platform="$PLATFORMS" \
        --manifest="$image" \
        --build-arg="JAVA_VERSION=$java_version" \
        --build-arg="BASE_SUFFIX=$suffix" \
        --build-arg="PAPER_VERSION=$version_number" \
        --build-arg="PAPER_BUILD=$latest_stable_build_id" \
        --build-arg="PAPER_ARGS=$recommended_flags" \
        --build-arg="PAPER_URL=$download_url" \
        --build-arg="PAPER_SHA256=$download_sha256" \
        .

    for platform in $(printf '%s' "$PLATFORMS" | tr ',' ' '); do
        smokeTest "$image" "$platform"
    done

    $DOCKER_COMMAND manifest push --all "$image" "docker://$image"

    if [ "$version_number" = "$latest_version_number" ]; then
        $DOCKER_COMMAND manifest push --all "$image" "docker://$REPOSITORY:latest${suffix}"
    fi

    $DOCKER_COMMAND manifest push --all "$image" "docker://$REPOSITORY:${version_number}-${latest_stable_build_id}${suffix}"
}

requireCommand curl 1
requireCommand jq 2

versions=$(curl -fsSL "$PAPER_API/versions")

case "${1:-full}" in
    plan)
        plan
        ;;
    full | alpine)
        requireCommand "$DOCKER_COMMAND" 3
        build "${1:-full}" "${2:-}"
        ;;
    *)
        usage
        ;;
esac
