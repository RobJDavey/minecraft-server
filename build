#!/usr/bin/env sh

set -euf

DOCKER_COMMAND=podman
export BUILDAH_FORMAT=docker

variant=${1:-full}

case "$variant" in
    full) suffix="" ;;
    alpine) suffix="-alpine" ;;
    *)
        echo "Usage: $0 [full|alpine]"
        exit 4
        ;;
esac

if ! command -v curl >/dev/null; then
    echo "curl not installed"
    exit 1
fi

if ! command -v jq >/dev/null; then
    echo "jq not installed"
    exit 2
fi

if ! command -v $DOCKER_COMMAND >/dev/null; then
    echo "$DOCKER_COMMAND not installed"
    exit 3
fi

versions=$(curl -fsSL https://fill.papermc.io/v3/projects/paper/versions)
version_numbers=$(printf '%s' "$versions" | jq -r '.versions[].version.id')

for version_number in $version_numbers; do
    builds=$(curl -fsSL "https://fill.papermc.io/v3/projects/paper/versions/$version_number/builds")
    latest_stable_build=$(printf '%s' "$builds" | jq -c 'map(select(.channel == "STABLE")) | first // empty')

    if [ -z "$latest_stable_build" ]; then
        printf 'Skipping Minecraft %s: no stable build\n' "$version_number"
        continue
    fi

    version_info=$(printf '%s' "$versions" | jq --arg v "$version_number" 'first(.versions[] | select(.version.id == $v))')
    java_version=$(printf '%s' "$version_info" | jq -r '.version.java.version.minimum')
    latest_stable_build_id=$(printf '%s' "$latest_stable_build" | jq -r '.id')
    download_url=$(printf '%s' "$latest_stable_build" | jq -r '.downloads."server:default".url')
    download_sha256=$(printf '%s' "$latest_stable_build" | jq -r '.downloads."server:default".checksums.sha256')
    recommended_flags=$(printf '%s' "$version_info" | jq -r '.version.java.flags.recommended | join(" ")')

    printf 'Building Minecraft %s with build %s on Java %s\n' "$version_number" "$latest_stable_build_id" "$java_version"

    $DOCKER_COMMAND pull "docker.io/library/eclipse-temurin:${java_version}${suffix}"

    $DOCKER_COMMAND build -f "./$variant/Dockerfile" \
        --build-arg="JAVA_VERSION=$java_version" \
        --build-arg="PAPER_VERSION=$version_number" \
        --build-arg="PAPER_BUILD=$latest_stable_build_id" \
        --build-arg="PAPER_ARGS=$recommended_flags" \
        --build-arg="PAPER_URL=$download_url" \
        --build-arg="PAPER_SHA256=$download_sha256" \
        -t "docker.io/robjdavey/minecraft-server:${version_number}${suffix}" \
        "./$variant"
    $DOCKER_COMMAND push "docker.io/robjdavey/minecraft-server:${version_number}${suffix}"

    $DOCKER_COMMAND tag "docker.io/robjdavey/minecraft-server:${version_number}${suffix}" "docker.io/robjdavey/minecraft-server:latest${suffix}"
    $DOCKER_COMMAND push "docker.io/robjdavey/minecraft-server:latest${suffix}"
    break
done
