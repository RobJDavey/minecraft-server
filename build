#!/usr/bin/env sh

set -euf

DOCKER_COMMAND=podman
PLATFORMS=linux/amd64,linux/arm64
export BUILDAH_FORMAT=docker

variant=${1:-full}

case "$variant" in
    full) suffix="" ;;
    alpine) suffix="-alpine" ;;
    *)
        echo "Usage: $0 [full|alpine]"
        exit 4
        ;;
esac

# Start the image for the given platform with no network, wait for the server
# to finish starting, then check it shuts down cleanly. Emulated platforms
# start slowly, so allow up to 5 minutes.
smokeTest() {
    printf 'Smoke testing %s\n' "$2"
    container=$($DOCKER_COMMAND run -d --platform "$2" --network none -e MEMORY=1G "$1")
    started=false

    for _ in $(seq 300); do
        if $DOCKER_COMMAND logs "$container" 2>&1 | grep -q 'Done ('; then
            started=true
            break
        fi
        if [ "$($DOCKER_COMMAND inspect -f '{{.State.Running}}' "$container")" != "true" ]; then
            break
        fi
        sleep 1
    done

    $DOCKER_COMMAND stop -t 60 "$container" >/dev/null
    logs=$($DOCKER_COMMAND logs "$container" 2>&1)
    $DOCKER_COMMAND rm -v "$container" >/dev/null

    if [ "$started" != "true" ]; then
        printf '%s\n' "$logs"
        echo "Smoke test failed: server did not start"
        return 1
    fi

    if ! printf '%s' "$logs" | grep -q 'Saving worlds'; then
        printf '%s\n' "$logs"
        echo "Smoke test failed: server did not shut down cleanly"
        return 1
    fi

    printf 'Smoke test passed on %s\n' "$2"
}

if ! command -v curl >/dev/null; then
    echo "curl not installed"
    exit 1
fi

if ! command -v jq >/dev/null; then
    echo "jq not installed"
    exit 2
fi

if ! command -v $DOCKER_COMMAND >/dev/null; then
    echo "$DOCKER_COMMAND not installed"
    exit 3
fi

versions=$(curl -fsSL https://fill.papermc.io/v3/projects/paper/versions)
version_numbers=$(printf '%s' "$versions" | jq -r '.versions[].version.id')

for version_number in $version_numbers; do
    builds=$(curl -fsSL "https://fill.papermc.io/v3/projects/paper/versions/$version_number/builds")
    latest_stable_build=$(printf '%s' "$builds" | jq -c 'map(select(.channel == "STABLE")) | first // empty')

    if [ -z "$latest_stable_build" ]; then
        printf 'Skipping Minecraft %s: no stable build\n' "$version_number"
        continue
    fi

    version_info=$(printf '%s' "$versions" | jq --arg v "$version_number" 'first(.versions[] | select(.version.id == $v))')
    java_version=$(printf '%s' "$version_info" | jq -r '.version.java.version.minimum')
    latest_stable_build_id=$(printf '%s' "$latest_stable_build" | jq -r '.id')
    download_url=$(printf '%s' "$latest_stable_build" | jq -r '.downloads."server:default".url')
    download_sha256=$(printf '%s' "$latest_stable_build" | jq -r '.downloads."server:default".checksums.sha256')
    recommended_flags=$(printf '%s' "$version_info" | jq -r '.version.java.flags.recommended | join(" ")')

    printf 'Building Minecraft %s with build %s on Java %s\n' "$version_number" "$latest_stable_build_id" "$java_version"

    image="docker.io/robjdavey/minecraft-server:${version_number}${suffix}"
    latest_image="docker.io/robjdavey/minecraft-server:latest${suffix}"

    # Remove any local image or manifest list with this name, so the build
    # starts a fresh manifest list instead of adding to an old one
    if $DOCKER_COMMAND manifest exists "$image"; then
        $DOCKER_COMMAND manifest rm "$image" >/dev/null
    elif $DOCKER_COMMAND image exists "$image"; then
        $DOCKER_COMMAND rmi "$image" >/dev/null
    fi

    $DOCKER_COMMAND build --pull -f ./Dockerfile \
        --platform="$PLATFORMS" \
        --manifest="$image" \
        --build-arg="JAVA_VERSION=$java_version" \
        --build-arg="BASE_SUFFIX=$suffix" \
        --build-arg="PAPER_VERSION=$version_number" \
        --build-arg="PAPER_BUILD=$latest_stable_build_id" \
        --build-arg="PAPER_ARGS=$recommended_flags" \
        --build-arg="PAPER_URL=$download_url" \
        --build-arg="PAPER_SHA256=$download_sha256" \
        .

    for platform in $(printf '%s' "$PLATFORMS" | tr ',' ' '); do
        smokeTest "$image" "$platform"
    done

    $DOCKER_COMMAND manifest push --all "$image" "docker://$image"
    $DOCKER_COMMAND manifest push --all "$image" "docker://$latest_image"
    break
done
